# Copy to config.env and edit:
#   cp config.env.example config.env && chmod 600 config.env
#
# Paths below default to the project directory when left relative.

# NetEase Cloud Music API (api-enhanced / ncm-api)
NCM_API_BASE=http://127.0.0.1:3000
# Node api-enhanced startup command; used only when the API is unavailable.
# Must start the service in the background and return promptly. Runs from project root.
# Python bounds execution and waits for API readiness; Apple credentials are not inherited.
# Leave unset if the API is managed elsewhere. Quote paths containing spaces.
# NCM_API_START_CMD='bash "/absolute/path/start-ncm-api.sh"'
COOKIE_FILE=./data/cookie.txt

# Apple Music
# Prefer MUSIC_USER_TOKEN here, or point AM_CONFIG at a yaml that has media-user-token:
# MUSIC_USER_TOKEN=
AM_CONFIG=./secrets/apple-music-config.yaml
STOREFRONT=cn
# Optional: leave empty to auto-extract AMPWebPlay JWT from music.apple.com
# DEVELOPER_TOKEN=

# Playlist naming: {PREFIX}-YYYY-MM-DD
PLAYLIST_PREFIX=网易云日推
PLAYLIST_DESCRIPTION="Auto-synced from NetEase Cloud Music daily recommend"

# Library playlist folder (created if missing when name is set)
PLAYLIST_FOLDER_NAME=网易云每日推荐
# Or pin by id: PLAYLIST_FOLDER_ID=p.xxxx

# Skip if today's playlist already exists
SKIP_IF_EXISTS=1
# Continue when some tracks fail to match Apple Music catalog
SKIP_UNMATCHED=1

# Apple Music API pacing / 429 handling (catalog search)
# Min seconds between any Apple API calls
AM_MIN_INTERVAL=0.75
# Retries on HTTP 429
AM_429_RETRIES=6
# Base wait seconds for exponential backoff (3, 6, 12, ...)
AM_429_BASE_WAIT=3
# Stop extra search terms once match score reaches this
MATCH_EARLY_SCORE=90

# --- AI-assisted daily matching (optional; disabled until configured) ---
# Only song metadata is sent. The first release applies AI to NetEase → Apple only.
AI_MATCHING_ENABLED=0
# openai = OpenAI-compatible chat/completions; anthropic = Claude messages
AI_MATCHING_PROVIDER=openai
AI_MATCHING_BASE_URL=https://api.openai.com/v1
# Required when enabled; use an exact model ID supported by your service.
AI_MATCHING_MODEL=
# Store only the API key in this private file (chmod 600); never put it in argv.
AI_MATCHING_API_KEY_FILE=./secrets/ai-api-key
# Network inactivity timeout, not a total wall-clock deadline.
AI_MATCHING_TIMEOUT=30
# Per-process budget; ambiguous songs may require two calls (select + extra search).
AI_MATCHING_MAX_CALLS=40

# --- Apple → NetEase feedback (optional reverse sync) ---
# Favorites playlist → NetEase red-heart (/like)
# Recent played tracks (incremental) → NetEase scrobble (/scrobble)
FEEDBACK_SYNC_LIKES=1
FEEDBACK_SYNC_SCROBBLE=1
# Set 1 to match only, no write (or pass --dry-run)
FEEDBACK_DRY_RUN=0
# System playlist name on Apple Music (CN often「喜爱歌曲」)
FEEDBACK_FAVORITES_PLAYLIST_NAME=喜爱歌曲
# Or pin by id: FEEDBACK_FAVORITES_PLAYLIST_ID=p.xxxx
FEEDBACK_RECENT_LIMIT=50
FEEDBACK_MAX_LIKES_PER_RUN=40
FEEDBACK_MAX_LIKE_SCAN_PER_RUN=80
FEEDBACK_MAX_SCROBBLE_PER_RUN=25
FEEDBACK_MIN_SCORE=55
# Seconds reported per scrobble (capped by track length)
FEEDBACK_SCROBBLE_TIME=240
# First run only snapshots recent window (no mass scrobble)
FEEDBACK_SCROBBLE_SEED_ONLY_FIRST=1
# AI review for red-hearts (also needs AI_MATCHING_ENABLED=1). Strong exact rule
# matches skip AI; weaker rule matches and misses are reviewed. Scrobbles stay rules-only.
FEEDBACK_AI_MATCHING=0
FEEDBACK_STATE_FILE=./data/feedback-state.json

LOG_DIR=./logs
DATA_DIR=./data
